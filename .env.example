DB_URL=jdbc:postgresql://localhost:5432/focaai
DB_USERNAME=focaai
DB_PASSWORD=focaai
# Origens da versão web do app (Expo web) que podem chamar a API, separadas por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:*
PORT=8080

# Assina os tokens de acesso da API — gere um valor forte e único antes de publicar
# (ex: openssl rand -base64 48). Nunca reaproveite o valor de exemplo abaixo.
JWT_SECRET=troque-isto-por-uma-chave-longa-e-aleatoria-antes-de-publicar
JWT_ACESSO_MINUTOS=60
JWT_RENOVACAO_DIAS=60

# Client IDs OAuth do FocaAI no Google Cloud (web, Android e iOS), separados por vírgula — ver README.
GOOGLE_CLIENT_IDS=
